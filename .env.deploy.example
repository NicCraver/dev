# 复制为 .env.deploy 并填写（勿提交到 git）
# cp .env.deploy.example .env.deploy

# 1) API Token（推荐自定义权限）
#    https://dash.cloudflare.com/profile/api-tokens
#    权限建议：
#      - Account → Cloudflare Pages → Edit
#      - Zone → DNS → Edit
#      - Zone → Zone → Read
CLOUDFLARE_API_TOKEN=

# 2) Account ID（32 位十六进制，不是邮箱！）
#    https://dash.cloudflare.com/ → 任意站点 → Overview 右侧 Account ID
CLOUDFLARE_ACCOUNT_ID=

# 3) 根域名：只写 nextdev.cc，不要 https:// 或末尾 /
CF_ROOT_DOMAIN=nextdev.cc

# 4) 子域名前缀（最终访问：https://mt-dev.example.com）
CF_SUBDOMAIN=mt-dev

# 可选：Pages 项目名（默认 mt-dev）
# CF_PAGES_PROJECT=mt-dev

# 可选：若自动查 zone 失败，可填 Zone ID
# CF_ZONE_ID=
