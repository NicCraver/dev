# API
PORT=6333

# MongoDB（mt-dev 库：集合 accounts + systems）
MONGODB_URI=mongodb://192.168.5.46:27017/mt-dev
EXTERNAL_LOGIN_BASE=https://env.lif3ng.cn:3443
# 设为 true 时始终跳过 TLS 校验；未设置时证书过期等错误会自动重试一次
# EXTERNAL_LOGIN_INSECURE=true
RECOMMEND_UPSTREAM=http://192.168.5.46:3000

# YApi 反代（/api/yapi/* → YAPI_UPSTREAM）
YAPI_UPSTREAM=http://127.0.0.1:3100

# PM2 Web UI（API 与 PM2 同机时启用）
PM2_ENABLED=false
PM2_API_TOKEN=
# PM2 页面访问密码（设则进入 /pm2 需验证；部署见 .env.deploy.ssh PM2_PAGE_PASSWORD）
PM2_PAGE_PASSWORD=
