# 复制为 .env.deploy.ssh 并填写（勿提交到 git）
# cp .env.deploy.ssh.example .env.deploy.ssh

# SSH 目标（内网/VPN；代码与 Docker 部署到此机器）
DEPLOY_HOST=env.lif3ng.cn
DEPLOY_USER=lifeng
DEPLOY_PATH=/home/lifeng/mt-dev

# 对外访问域名（Cloudflare A 记录 env.nextdev.cc → 内网 IP，仅 DNS）
DEPLOY_PUBLIC_URL=http://env.nextdev.cc

# 旧 IP 直连端口（Nginx 51611 跳转启用后仅作兼容；主访问走 80 域名）
DEPLOY_WEB_PORT=51611

# 健康检查
DEPLOY_HEALTH_URL=http://env.nextdev.cc/api/health

# PM2 页面访问密码（部署时写入服务器 apps/api/.env 的 PM2_PAGE_PASSWORD）
PM2_PAGE_PASSWORD=

# 可选：非 22 端口
# DEPLOY_SSH_PORT=22
